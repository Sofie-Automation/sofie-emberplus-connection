{
	"name": "emberplus-connection",
	"version": "0.3.1",
	"description": "Javascript implementation of the Ember+ automation protocol",
	"engines": {
		"node": ">=22.12"
	},
	"files": [
		"dist/**/*"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepare": "husky",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --check .",
		"lint:prettier:fix": "prettier --write .",
		"lint": "yarn lint:eslint && yarn lint:prettier",
		"lint:fix": "yarn lint:eslint --fix && yarn lint:prettier:fix",
		"unit": "vitest run --coverage",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "run lint && run check-types && vitest run",
		"test:coverage": "run test -- --coverage",
		"cov": "vitest run --coverage; open-cli coverage/lcov-report/index.html",
		"cov-open": "open-cli coverage/lcov-report/index.html",
		"changelog": "sofie-version",
		"release": "run reset && run test && sofie-version",
		"reset": "git clean -dfx && git reset --hard && yarn",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit --environment development",
		"license-validate": "sofie-licensecheck --allowPackages argparse@3.0.4 --allowLicenses MPL-2.0"
	},
	"contributors": [
		"Gilles Dufour <dufour.gilles@gmail.com> (www.gdnet.be)",
		"Brian Mayton <bmayton@bdm.cc> (http://bdm.cc)",
		"Ola Christian Gundelsby <ola.christian.gundelsby@nrk.no> (https://nrk.no)",
		"Balte de Wit <contact@balte.nl> (https://superfly.tv/)",
		"Richard Cartwright (https://superfly.tv/)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sofie-Automation/sofie-emberplus-connection"
	},
	"license": "MIT",
	"dependencies": {
		"debug": "^4.3.4",
		"smart-buffer": "^3.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sofie-automation/code-standard-preset": "~4.0.3",
		"@types/debug": "^4.1.9",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10",
		"husky": "^9",
		"lint-staged": "^17",
		"prettier": "^3",
		"rimraf": "^6.1.4",
		"typescript": "~6.0",
		"vite": "^8",
		"vitest": "^5.1.0"
	},
	"bugs": {
		"url": "https://github.com/Sofie-Automation/sofie-emberplus-connection/issues"
	},
	"homepage": "https://github.com/Sofie-Automation/sofie-emberplus-connection#readme",
	"keywords": [
		"emberplus",
		"lawo"
	],
	"lint-staged": {
		"*.{css,json,md,scss,yaml,yml}": [
			"prettier --check"
		],
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"eslint"
		]
	},
	"packageManager": "yarn@4.18.1"
}
